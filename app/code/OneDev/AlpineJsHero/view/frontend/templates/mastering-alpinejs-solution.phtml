<!-- Task 8: Shopping Cart with Global State -->
<div class="mb-6">
    <div class="mt-5 mb-5">
        <h2 class="text-xl font-semibold mb-6">Task 8: Shopping Cart with Global State</h2>
        <p class="mb-6"><strong>Task:</strong> Create a global shopping cart using Alpine.js's store. Add an "Add to Cart" button that pushes items to a cart. Display the total items in the cart below the button so the cart items in the console.log with <code>x-effect</code></p>
        <button onclick="toggleHint(8)" class="bg-blue-500 text-white px-4 py-2 rounded mt-2">Show Hint</button>
        <p id="hint-8" class="hint mt-2 text-gray-600"><strong>Hint:</strong> Use <code>Alpine.store()</code> for global state and <code>$store</code> to access the cart.</p>
    </div>

    <hr class="mb-6 mt-6">
    <!-- ToDo start -->
    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.store('cart', { items: [] });
        });
    </script>

    <div x-data class="p-4 border border-gray-300 rounded">
        <button class="bg-blue-500 text-white px-4 py-2 rounded" @click="$store.cart.items.push('Apple')">Add to Cart</button>
        <p class="mt-2">Items in cart: <span x-text="$store.cart.items.length"></span></p>
        <div x-effect="console.log('Cart item: ' + $store.cart.items)"></div>
    </div>
    <!-- ToDo end -->
    <hr class="mb-6 mt-6">
</div>

<!-- JavaScript for Hint Toggle -->
<script>
    function toggleHint(taskNumber) {
        const hint = document.getElementById(`hint-${taskNumber}`);
        hint.style.display = hint.style.display === 'none' || hint.style.display === '' ? 'block' : 'none';
    }
</script>

<!-- Hide hints by default -->
<style>
    .hint {
        display: none;
    }
</style>
