/**
 * This test demonstrates how to work with local storage using hyva.getBrowserStorage
 */
?>

<script>
    // Practical test for working with browser storage
    document.addEventListener('DOMContentLoaded', function() {
        // ToDo.: Get the actually browserStorage using hyva
        const browserStorage = hyva.getBrowserStorage();

        if (browserStorage) {
            // ToDo.: Store a value in browser storage
            browserStorage.setItem('user_preference', 'dark_mode');

            // ToDo.: Retrieve and display the stored value within the container with the ID: storage-result
            const storedPreference = browserStorage.getItem('user_preference');

            document.getElementById('storage-result').innerText = storedPreference;

        } else {
            // ToDo.: Retrieve 'Storage Unavailable' text within the container with the ID storage-result, if the browserStorage is not available
            document.getElementById('storage-result').innerText = 'Storage Unavailable';
        }

        // ToDo.: Optional: Remove the previous stored value on button click
        document.getElementById('clear-storage').addEventListener('click', function() {
            if (browserStorage) {
                browserStorage.removeItem('user_preference');
                document.getElementById('storage-result').innerText = 'Cleared';
            }
        });
    });
</script>

<div class="p-6 max-w-md mx-auto bg-white rounded-xl shadow-md space-y-4 mt-6">
    <h3 class="text-lg font-semibold text-gray-800">Local Storage Test</h3>
    <p class="text-gray-600">This test shows how to use browser storage using <code>hyva.getBrowserStorage</code>. It saves and retrieves a user preference.</p>
    <p class="text-gray-800">The stored user preference is: <span id="storage-result" class="font-bold">Loading...</span></p>
    <button id="clear-storage" class="mt-3 bg-red-500 text-white font-bold py-2 px-4 rounded-md hover:bg-red-600">
        Clear Storage
    </button>
</div>

