/**
 * This test shows how to set and get cookies using window.hyva
 */
?>

<script>
    // Practical test for setting and getting cookies
    document.addEventListener('DOMContentLoaded', function() {
        const cookieName = 'test_cookie';
        const cookieValue = 'test';
        const expiryDays = 1;

        // ToDo.: Set the cookie using hyva.setCookie
        hyva.setCookie(cookieName, cookieValue, expiryDays);

        // ToDo.: Get and display the cookie value in the console.log
        const retrievedCookie = hyva.getCookie(cookieName);

        console.log('Retrieved cookie value:', retrievedCookie);

        // ToDo.: Display the cookie value in a div
        document.getElementById('cookie-result').innerText = retrievedCookie;
    });
</script>

<div class="p-6 max-w-md mx-auto bg-white rounded-xl shadow-md space-y-4">
    <h3 class="text-lg font-semibold text-gray-800">Cookie Test</h3>
    <p class="text-gray-600">This test demonstrates how to set and retrieve a cookie value using <code>hyva.setCookie</code> and <code>hyva.getCookie</code>.</p>
    <p class="text-gray-800">The test cookie value is: <span id="cookie-result" class="font-bold">Loading...</span></p>
</div>


