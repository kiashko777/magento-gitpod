/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\Modal;
use Magento\Framework\Escaper;
use Magento\Catalog\Helper\Image;
use Magento\Framework\Pricing\Helper\Data as PriceHelper;
use OneDev\HyvaHero\ViewModel\ProductList;

$modalViewModel = $viewModels->require(Modal::class);
$productListViewModel = $viewModels->require(ProductList::class);

// Fetch the products
$products = $productListViewModel->getProducts();
$imageHelper = $this->helper(Image::class);
$priceHelper = $this->helper(PriceHelper::class);

// Construct the modal content
$content = '<div id="hyva-modal-title">'
    . $escaper->escapeHtml(__('Simple Modal')) . '</div>';

$content .= '<div class="product-list"><ul>';

// Loop through the products and add them to the modal
foreach ($products as $product) {
    $imageUrl = $imageHelper->init($product, 'product_page_image_small')
        ->setImageFile($product->getFile())
        ->getUrl();

    $content .= '<li><img src="' . $escaper->escapeUrl($imageUrl) . '" alt="' . $escaper->escapeHtml($product->getName()) .'">'
        . $escaper->escapeHtml($product->getName()) . ' - '
        . $escaper->escapeHtml($priceHelper->currency($product->getPrice(), true, true)) . '</li>';
}

// Close the list
$content .= '</ul></div>';

// Add the confirm and close buttons
$content .= '<div class="modal-buttons">'
    . '<button @click="confirm()" type="button">'
    . $escaper->escapeHtml(__('Confirm')) . '</button>'
    . '<button @click="showModal = false" type="button">'
    . $escaper->escapeHtml(__('Close')) . '</button>'
    . '</div>';

// Create the modal using the Modal view model and attach the content
$modal = $modalViewModel->createModal()
    ->withContent($content)
    ->withAriaLabelledby('simple-modal');

// Output the modal
?>

<!-- Button to open the modal -->
<div x-data="{ showModal: false }">
    <button @click="showModal = true">
        <?= $escaper->escapeHtml(__('Open Simple Modal')) ?>
    </button>

    <!-- Modal content -->
    <div x-show="showModal" x-transition>
        <?= /** @noEscape */ $modal ?>
    </div>
</div>
